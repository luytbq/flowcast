flowchart TD
    a([Click forgot password]) --> b[Enter email]
    b --> c{Email exists?}
    c -->|No| d[Show generic notice]
    c -->|Yes| e[Send reset link]
    e --> d
    d --> f([Await email])
    f -.-> g[Open link]
    g --> h{Link valid?}
    h -->|Expired| b
    h -->|Valid| i[Set new password]
    i --> j{Strong?}
    j -->|Weak| i
    j -->|Strong| k([Log in again])
